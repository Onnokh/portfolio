{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    // From the site's node_modules: the video draws the site's own card, from ../src.
    "types": ["vite/client", "@webgpu/types"]
  },
  "include": ["src", "remotion.config.ts"]
}
